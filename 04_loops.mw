# 04 - Doing things again and again

repeat 3 times
    say "Hip hip hooray!"
end

count i from 1 to 5
    say "{i} x 7 = {i times 7}"
end

count n from 10 down to 0 by 2
    say "countdown {n}"
end

set coins to 0
repeat while coins is less than 50
    add 15 to coins
end
say "I saved {coins} coins."

repeat until coins is less than 10
    take 12 from coins
end
say "Spent them down to {coins}."

for each letter in "MEMO"
    say letter
end

for each n in range(1, 20)
    if n is divisible by 3 then skip
    if n is more than 10 then stop
    say "{n} is not divisible by 3"
end
