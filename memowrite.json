{
  "Say": { "prefix": "say", "body": ["say \"${1:Hello!}\""], "description": "Show something" },
  "Ask": { "prefix": "ask", "body": ["ask \"${1:What is your name?}\" into ${2:name}"], "description": "Ask a question" },
  "Set": { "prefix": "set", "body": ["set ${1:score} to ${2:0}"], "description": "Give a name a value" },
  "If": { "prefix": "if", "body": ["if ${1:score} is more than ${2:10} then", "\t$0", "end"], "description": "Decide something" },
  "If otherwise": { "prefix": "ifelse", "body": ["if ${1:answer} is \"${2:yes}\" then", "\t$3", "otherwise", "\t$0", "end"], "description": "If / otherwise" },
  "Repeat": { "prefix": "repeat", "body": ["repeat ${1:5} times", "\t$0", "end"], "description": "Do something again" },
  "Repeat while": { "prefix": "while", "body": ["repeat while ${1:lives} is more than 0", "\t$0", "end"], "description": "Loop while something is true" },
  "Forever": { "prefix": "forever", "body": ["repeat forever", "\t$0", "\twait 0.02 seconds", "end"], "description": "Loop forever" },
  "Count": { "prefix": "count", "body": ["count ${1:i} from ${2:1} to ${3:10}", "\t$0", "end"], "description": "Count through numbers" },
  "For each": { "prefix": "foreach", "body": ["for each ${1:item} in ${2:things}", "\t$0", "end"], "description": "Go through a list" },
  "Task": { "prefix": "task", "body": ["make task ${1:greet} with ${2:who}", "\t$0", "end"], "description": "Make your own command" },
  "Task that gives back": { "prefix": "function", "body": ["make task ${1:double} with ${2:n}", "\tgive back ${2:n} * 2", "end"], "description": "A task that gives back a value" },
  "List": { "prefix": "list", "body": ["make list ${1:fruits} with ${2:\"apple\", \"banana\"}"], "description": "Make a list" },
  "Book": { "prefix": "book", "body": ["make book ${1:pet} with ${2:name} as \"${3:Rex}\", ${4:age} as ${5:3}"], "description": "Make a book (named values)" },
  "Kind": { "prefix": "kind", "body": ["make kind ${1:pet} with ${2:name}, ${3:sound}", "\tmake task speak", "\t\tsay my ${2:name} + \" says \" + my ${3:sound}", "\tend", "end"], "description": "Make a blueprint" },
  "Try": { "prefix": "try", "body": ["try", "\t$1", "if it fails as problem", "\tsay \"Problem: \" + problem", "end"], "description": "Catch problems" },
  "Remember": { "prefix": "remember", "body": ["remember \"${1:high score}\" as ${2:score}"], "description": "Save forever in File.Memory" },
  "Recall": { "prefix": "recall", "body": ["recall \"${1:high score}\" into ${2:best} or ${3:0}"], "description": "Load from File.Memory" },
  "Window": { "prefix": "window", "body": ["make window ${1:app} titled \"${2:My App}\" sized ${3:420} by ${4:320}", "add heading title to ${1:app} saying \"${2:My App}\"", "add button go to ${1:app} saying \"${5:Click me}\" doing ${6:clicked}", "", "make task ${6:clicked}", "\tshow message \"Hello!\"", "end"], "description": "A window app" },
  "Button": { "prefix": "button", "body": ["add button ${1:go} to ${2:app} saying \"${3:Click me}\" doing ${4:clicked}"], "description": "Add a button" },
  "Label": { "prefix": "label", "body": ["add label ${1:info} to ${2:app} saying \"${3:Hello}\""], "description": "Add a label" },
  "Input": { "prefix": "input", "body": ["add input box ${1:nameBox} to ${2:app} placeholder \"${3:Type here}\""], "description": "Add an input box" },
  "Canvas": { "prefix": "canvas", "body": ["add canvas ${1:board} to ${2:app} sized ${3:400} by ${4:300} background \"${5:white}\""], "description": "Add a drawing canvas" },
  "Draw circle": { "prefix": "circle", "body": ["draw circle at ${1:100}, ${2:100} size ${3:30} color \"${4:red}\" called ${5:ball}"], "description": "Draw a circle" },
  "Draw rectangle": { "prefix": "rect", "body": ["draw rectangle at ${1:50}, ${2:50} size ${3:120} by ${4:60} color \"${5:blue}\""], "description": "Draw a rectangle" },
  "Model": { "prefix": "model", "body": ["make model ${1:car}", "\trectangle at -30, -10 size 60 by 20 color \"red\"", "\tcircle at -18, 12 size 7 color \"black\"", "\tcircle at 18, 12 size 7 color \"black\"", "end", "", "place model ${1:car} at ${2:200}, ${3:150} called ${4:myCar}"], "description": "A 2D model" },
  "Game loop": { "prefix": "game", "body": ["every 16 milliseconds do update", "", "make task update", "\tif key_down(\"left\") then move ${1:player} by -5, 0", "\tif key_down(\"right\") then move ${1:player} by 5, 0", "end"], "description": "A game loop with arrow keys" },
  "When clicked": { "prefix": "when", "body": ["when ${1:go} is clicked do ${2:clicked}"], "description": "React to a click" },
  "When key": { "prefix": "whenkey", "body": ["when key \"${1:space}\" is pressed do ${2:jump}"], "description": "React to a key" }
}
